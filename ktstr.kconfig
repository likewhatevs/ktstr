# -- Architecture defensives (x86_64) --
# CONFIG_X86_FRED=y kernels skip idt_syscall_init (arch/x86/kernel/cpu/common.c:2303-2304)
# and never write MSR_LSTAR. ktstr's virt-KASLR derivation reads MSR_LSTAR to
# recover the runtime KVA of entry_SYSCALL_64 — FRED would silently break that
# path and corrupt every per-CPU read on KASLR-enabled boots. Locked off here
# as a belt-and-suspenders measure since FRED is gaining adoption upstream and
# an inherited defconfig flip would silently invalidate ktstr's KASLR fix.
# CONFIG_X86_FRED is not set

# CONFIG_RANDOMIZE_BASE=y forces virt-KASLR on for every ktstr boot. The
# `kaslr_offset_nonzero_post_boot` e2e test (tests/kaslr_axis_e2e.rs) depends
# on a non-zero KASLR offset to exercise the freeze_coord → compute_rq_pas
# wire-in; an inherited defconfig that flipped this off would silently
# degrade the test into a tautology (kaslr=0 makes the buggy and fixed
# paths agree on the same PA). Pinning here keeps the assertion meaningful.
CONFIG_RANDOMIZE_BASE=y

# CONFIG_RANDOMIZE_MEMORY=y randomizes `page_offset_base`, `vmalloc_base`,
# and `vmemmap_base` at boot — independent of the kernel-image text/data
# slide which CONFIG_RANDOMIZE_BASE=y above controls. The host resolves the
# runtime `page_offset_base` from the `page_offset_base` symbol
# (`monitor::symbols`, via `symbols::page_offset_base_kva` and
# `kva_to_pa` / `resolve_page_offset`), falling back to `DEFAULT_PAGE_OFFSET`
# when the symbol is absent (aarch64) or unreadable. The guest also reads
# the runtime KVA from `/proc/kallsyms`
# (`guest_comms::read_kernel_page_offset_base_from_kallsyms`, called from
# `src/vmm/rust_init/init.rs`) and ships it in `KernAddrs.page_offset_base`
# (`src/vmm/wire.rs`), but the host KERN_ADDRS handler
# (`src/vmm/freeze_coord/dispatch.rs`) currently consumes only `phys_base`
# and `kernel_text_runtime_kva` — that wire slot is unused. Operators opt
# out with `kargs = ["nokaslr"]` on the scheduler decl or
# `#[ktstr_test(kaslr = false, ...)]` per test. The
# `kaslr_page_offset_derivation_nonzero` e2e test guards the runtime value:
# `page_offset_base` must lie in `[default_page_offset, VADDR_END)` and be
# PUD-aligned (1 GiB) relative to `default_page_offset` — the L4 base
# `0xffff_8880_0000_0000` or the L5 base `0xff11_0000_0000_0000` depending
# on paging mode (per arch/x86/mm/kaslr.c::kernel_randomize_memory). The
# ~1/30000 slot-0 outcome (`page_offset_base == default_page_offset`) only
# warns; it does not fail. Pinning =y here so an inherited defconfig flip
# can't silently degrade the test back into a tautology where the buggy
# and fixed direct-map paths agree on the compile-time default.
CONFIG_RANDOMIZE_MEMORY=y

# CONFIG_GCC_PLUGIN_RANDSTRUCT=n keeps `struct task_struct` field order
# deterministic across builds. The TaskField cold-path Op handler
# (`src/vmm/freeze_coord/kernel_op_dispatch.rs`) resolves field byte
# offsets via the live vmlinux's BTF at dispatch time, so RANDSTRUCT
# layouts ARE correctly handled when BTF is present. This pin is
# defense-in-depth: a kernel built without BTF coverage for `task_struct`
# (extremely stripped vmlinux) combined with RANDSTRUCT would silently
# read garbage at the wrong byte offsets — the TaskField dispatcher's
# 8-layer validation would catch obvious corruption (pid mismatch,
# start_boottime=0) but a fortuitous match could land an undetected
# write. Disabling RANDSTRUCT removes the dependence on BTF coverage
# for the task_struct subset that TaskField writes.
# CONFIG_GCC_PLUGIN_RANDSTRUCT is not set

# -- sched_ext + BPF (required) --
# sched_ext scheduling class. Depends on BPF_SYSCALL + BPF_JIT + DEBUG_INFO_BTF.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_SCHED_CLASS_EXT=y

# -- Debug info (required) --
# BTF for monitor struct resolution, BPF CO-RE, probe output.
# DWARF for source locations in probe output.
# DEBUG_INFO_REDUCED breaks BTF generation — must stay off.
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
# Module BTF embeds BTF into .ko files. ktstr runs a monolithic
# kernel with no loadable modules — the scheduler is a BPF program,
# not a .ko. Disable to avoid resolve_btfids/pahole crashes during
# modfinal on some arm64 toolchains.
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_DEBUG_INFO_REDUCED is not set

# -- Tracing/probes (required) --
# Kprobes for ktstr probe pipeline. ftrace for dynamic attachment
# and scx scheduler tracing (e.g. LAVD futex tracing).
# PERF_EVENTS: explicit dep of BPF_EVENTS (provided by defconfig's
# PROFILING=y, but stated here so the tracing section is self-contained).
# FTRACE: top-level gate for all tracing infrastructure. arm64 defconfig
# disables it — without FTRACE=y, KPROBE_EVENTS, BPF_EVENTS, and
# FUNCTION_TRACER are silently dropped (inside `if FTRACE` in Kconfig).
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
# HW_PERF_EVENTS: hardware PMU sampling. On arm64 this is def_bool y
# guarded on ARM_PMU (drivers/perf/Kconfig); declaring it explicitly
# makes the dependency visible. Required for sched_ext schedulers
# (scx_layered, scx_cosmos) that read perf counters via BPF kfuncs.
# x86 builds ignore this symbol (x86 PMU support is unconditional via
# CONFIG_PERF_EVENTS above); the symbol is defined only in
# arch/arm64/Kconfig.
CONFIG_HW_PERF_EVENTS=y
# ARM_PMUV3: arm64 PMUv3 driver (drivers/perf/arm_pmuv3.c). bool with
# `default ARM64` and `depends on HW_PERF_EVENTS && ((ARM && CPU_V7) ||
# ARM64)` (drivers/perf/Kconfig). On arm64 it would be picked up by
# defconfig anyway; declaring it explicitly pins the PMU driver in the
# kconfig fragment so future merge_config runs cannot silently drop it
# if the dependency chain changes. x86 builds ignore this symbol — it
# is gated on ARM/ARM64 in drivers/perf/Kconfig.
CONFIG_ARM_PMUV3=y
# BPF_EVENTS: default y when deps met (KPROBE_EVENTS + PERF_EVENTS).
# Explicit for clarity.
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_FS=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
# FTRACE_SYSCALLS: per-syscall entry/exit tracepoints — what bpftrace
# exposes as tracepoint:syscalls:sys_enter_*/sys_exit_*. Default n and
# absent from both arch defconfigs, so a debugging binary shipped into
# shell mode via --include-files (e.g. bpftrace) had no syscall
# tracepoints to attach to. Dormant cost is zero for scheduler timing:
# the syscall-path work is gated on the per-task SYSCALL_TRACEPOINT
# syscall-work flag, which syscall_regfunc (kernel/tracepoint.c) sets
# only while at least one syscall tracepoint is registered. Both
# x86_64 and arm64 select HAVE_SYSCALL_TRACEPOINTS.
CONFIG_FTRACE_SYSCALLS=y
# Preempt-disabled duration capture (#64).
# tp_btf/preempt_disable + preempt_enable handlers in probe.bpf.c
# attach to the trace_preempt_off / trace_preempt_on tracepoints
# defined in include/trace/events/preemptirq.h. These tracepoints
# are emitted from kernel/trace/trace_preemptirq.c only when
# CONFIG_TRACE_PREEMPT_TOGGLE is set; the option in turn depends
# on PREEMPT_TRACER (Kconfig under kernel/trace/Kconfig).
# Without these, the BPF program loads but the two tp_btf attaches
# silently fail and per-CPU max_ns stays at 0 — graceful degradation
# matching other optional tp_btf attaches in the probe.
CONFIG_PREEMPT_TRACER=y
CONFIG_TRACE_PREEMPT_TOGGLE=y

# -- Boot/console (required) --
# Init script mounts /proc (reads /proc/cmdline for SHM_BASE),
# /sys (sysfs for cgroups, tracing), and reads /dev/mem for
# SHM dump polling.
#
# Serial: x86 VMM uses ISA 16550 (COM1/COM2), arm64 uses ns16550a via MMIO.
# Both drivers are included so the same fragment works on either arch.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# FDT-based probing for 8250 ports — required on arm64 where the
# VMM's ns16550a UARTs are described in the device tree. Without
# this, the kernel has no driver to match the ns16550a FDT nodes
# and /dev/ttyS* devices are never created.
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_BINFMT_SCRIPT=y
# x86 only — arm64 uses earlycon (auto-selected by PL011/8250 drivers).
CONFIG_EARLY_PRINTK=y

# -- Virtio device support --
# VIRTIO + VIRTIO_MMIO are the transport layer the VMM exposes; both
# are required for any virtio device (console, block, or net) to
# probe. VIRTIO_MMIO_CMDLINE_DEVICES lets the kernel pick up the
# `virtio_mmio.device=...` kernel cmdline entries the VMM appends so
# devices land in deterministic probe order. The console device
# powers /dev/hvc0 for shell mode; the block device is used by tests
# that need a real disk (DiskConfig); the net device is used by
# tests that need a NIC and is also a future-proofing knob (#20).
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# -- PCI bus (virtio-PCI transport) --
# The virtio-PCI transport exposes NICs (and future PCI devices) via a
# host bridge at 00:00.0 plus an ECAM/CAM config space. PCI must be
# compiled in for the guest to enumerate ANY of it; the per-VM
# `pci=off` cmdline (appended when a test does not request PCI) gates
# scanning at runtime, so a PCI-capable kernel is harmless for non-PCI
# tests. x86_64_defconfig sets CONFIG_PCI=y, but pin it here so an
# inherited-defconfig flip or an --extra-kconfig that strips it cannot
# silently disable the transport — the failure mode would be a guest
# with no /sys/bus/pci and every PCI device invisible. PCI_MMCONFIG
# backs ECAM (extended config space, reg >= 256) which the VMM's MCFG
# table and _SB.PCI0 DSDT window describe; it is `default y` on x86_64
# when PCI + ACPI are set (arch/x86/Kconfig:2918) and pinned here for
# the same defense-in-depth reason (base config still works CAM-only if
# it is dropped). Both are x86 symbols; arm64 PCI uses
# PCI_HOST_GENERIC, a later increment when arm64 virtio-PCI lands.
#
# ACPI is the linchpin of the x86 PCI transport: the guest parses the MCFG
# (ECAM base), the _SB.PCI0 DSDT _PRT (PCI INTx -> GSI routing), and the
# FADT PM register blocks only when ACPI is enabled. x86_64_defconfig sets
# CONFIG_ACPI=y; pin it here for the same defense-in-depth reason — if an
# inherited-defconfig flip or --extra-kconfig drops it, PCI_MMCONFIG
# (default y only on PCI && ACPI) silently drops too (ECAM gone) and PCI
# INTx falls back to legacy MP-table routing with no NIC entry
# (pci_dev->irq==0 -> vp_find_vqs_intx request_irq fails -> virtnet_probe
# -EINVAL) — the exact failure the FADT PM blocks + _PRT exist to fix, but
# now silent. arm64 discovers devices via DT, so a compiled-in ACPI is
# harmless there (its defconfig also sets =y); this pin is x86's foundation.
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MMCONFIG=y
# VIRTIO_PCI is the guest DRIVER that binds virtio devices on the PCI
# transport: the virtio-net NIC enumerates as a PCI function, and only
# this driver attaches to it (CONFIG_PCI is the bus; CONFIG_VIRTIO_NET
# is the transport-agnostic net driver). Without it the guest sees the
# PCI device but nothing binds, so the NIC's eth* interface never
# appears. Pinned so an inherited-defconfig flip or an --extra-kconfig
# strip surfaces as a build error rather than a silent in-guest bind
# failure.
CONFIG_VIRTIO_PCI=y

# -- Networking --
# PACKET: AF_PACKET sockets (net/packet/Kconfig:6 — "communicate directly
# with network devices ... e.g. tcpdump"), the raw-frame device-level TX/RX
# path rather than the kernel-internal IP layer. PACKET has no `depends on`
# of its own (it sits under `if NET`); NET stays on because both arch
# defconfigs set CONFIG_NET=y. Both defconfigs also already set
# CONFIG_PACKET=y, so this line is a defense-in-depth pin (like the
# RANDOMIZE_* pins above), not a first-time enable: it keeps an
# inherited-defconfig flip from silently dropping the symbol the wide-SMP
# net-IRQ e2e (tests/wide_smp_net_irq_e2e.rs) relies on (it opens an
# AF_PACKET raw socket).
CONFIG_PACKET=y

# -- Filesystems --
# Btrfs: optional, for DiskConfig::Btrfs when the template-VM
# lifecycle lands. Requires crypto deps (CRC32, BLAKE2B, SHA256,
# ZLIB); if deps are not met, make olddefconfig silently drops it.
# Not in VALIDATE_CONFIG_CRITICAL — v0 uses Filesystem::Raw.
CONFIG_BTRFS_FS=y

# -- Topology (required) --
# Multi-socket/core/thread VMs with NUMA.
# On x86_64, X86_64_ACPI_NUMA is def_bool y when NUMA + ACPI + PCI
# and selects ACPI_NUMA automatically.
CONFIG_SMP=y
# CONFIG_X86_X2APIC=y: x86 guests with >254 vCPUs need x2APIC (32-bit
# APIC IDs). Legacy xAPIC has only 255 8-bit APIC IDs and the IOAPIC
# consumes one, capping plain-xAPIC SMP at 254. Without this,
# MAX_LOCAL_APIC stays 256 (arch/x86/include/asm/apicdef.h) and
# acpi_parse_x2apic ignores every MADT x2APIC (type-9) entry
# (arch/x86/kernel/acpi/boot.c — its body is under #ifdef
# CONFIG_X86_X2APIC), so no CPU with APIC ID >255 can be registered or
# onlined. x86-only; arm64 ignores the symbol (GICv3 handles wide SMP).
CONFIG_X86_X2APIC=y
# CONFIG_NR_CPUS bounds the kernel's compile-time max CPU count. The
# x86_64 default is 64 — far below the wide-SMP topologies ktstr exercises.
# x86_64 caps the Kconfig range at 512 without CONFIG_MAXSMP
# (arch/x86/Kconfig: NR_CPUS_RANGE_END=512 unless MAXSMP selects
# CPUMASK_OFFSTACK); an out-of-range value is silently dropped back to the
# default 64. 512 is therefore the max settable without MAXSMP, which we
# avoid because it force-selects DEBUG_KERNEL (can perturb scheduling
# timing — unwanted in a scheduler test tool). 512 covers ktstr's wide-SMP
# guests (the 256-vCPU split-irqchip e2e; the documented 512 ceiling).
CONFIG_NR_CPUS=512
# HOTPLUG_PARALLEL: parallel AP bring-up. On x86_64 the CPUHP_BP_PARALLEL_*
# states run the INIT/SIPI (send-init, wait-for-callin) startup phase of every
# AP concurrently in smp_init, instead of the fully serial per-CPU
# bringup_nonboot_cpus loop (kernel/cpu.c cpuhp_bringup_cpus_parallel, added in
# 6.5). For the wide-SMP guests ktstr boots (the 256-vCPU e2es) that serialized
# INIT-SIPI-SIPI handshake is the dominant boot handoff chain, and it stretches
# further when the host is contended and every vCPU's wall-clock is diluted;
# parallelizing it collapses the chain so wide guests reach userspace sooner.
# x86_64-only: `arch/x86/Kconfig` `select HOTPLUG_PARALLEL if SMP && X86_64`, so
# on an x86_64 SMP build this is already y from the arch select — the symbol is
# a promptless `bool` in `arch/Kconfig` (not directly settable), so this line
# documents the dependency ktstr's wide-SMP boot relies on rather than forcing
# it, and `make olddefconfig` drops it on arm64 (arm64 does not select it; GICv3
# AP bring-up is a different path) without any effect. Deliberately NOT in
# VALIDATE_CONFIG_CRITICAL: it is unsettable and arm64-absent, so a presence
# check would false-fail there.
#
# Does NOT change the boot-ordering invariant the scheduler path depends on:
# smp_init runs to completion (all APs onlined) before the kernel starts PID 1,
# and ktstr's PID-1 init independently gates scheduler spawn on
# `all_possible_cpus_online()` before Phase 3 — see
# `src/vmm/rust_init/topology.rs` and its caller in `rust_init/init.rs`
# (the AP-gap check precedes `start_scheduler`). Parallel bring-up only changes
# HOW FAST the APs come online, never whether they are all online first.
CONFIG_HOTPLUG_PARALLEL=y
CONFIG_NUMA=y
# HMAT: parses ACPI HMAT for memory tiering (CXL nodes).
# NUMA_BALANCING: auto-migrates pages to local node based on access.
CONFIG_ACPI_HMAT=y
CONFIG_NUMA_BALANCING=y

# -- Cgroups (required) --
# Scenario cpuset partitioning and CPU controller.
CONFIG_CGROUPS=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_SCHED=y

# -- KVM guest (required) --
# Steal time accounting: guest scheduler sees actual CPU time
# (not wall clock including host preemption), producing
# bare-metal-like scheduling decisions.
# x86: kvmclock via HYPERVISOR_GUEST + PARAVIRT.
# arm64: SMCCC PV Time via PARAVIRT (auto-selected by
#        PARAVIRT_TIME_ACCOUNTING). HYPERVISOR_GUEST is
#        x86-only and silently ignored on arm64.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_TIME_ACCOUNTING=y

# -- Scheduler features (safe, no behavioral change) --
# SCHEDSTATS: runtime-disabled by default (static key NOP).
# Opt in via sysctl kernel.sched_schedstats=1.
CONFIG_SCHEDSTATS=y
# SCHED_MC: multi-core scheduling awareness. Affects task
# placement across cores within a package.
CONFIG_SCHED_MC=y
# TASK_DELAY_ACCT: gates /proc/<tid>/stat field 42
# (delayacct_blkio_ticks). Without this, the field is hard-coded 0
# in delayacct_blkio_ticks() (include/linux/delayacct.h). Also
# `select`s SCHED_INFO. Requires runtime opt-in via the `delayacct`
# kernel cmdline parameter or sysctl kernel.task_delayacct=1
# (delayacct_on starts at 0 in kernel/delayacct.c).
# Depends on TASKSTATS, which depends on NET + MULTIUSER. TASKSTATS
# defaults to n; declare it explicitly so merge_config does not
# silently drop TASK_DELAY_ACCT.
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
# Symbols for monitor kallsyms resolution.
CONFIG_KALLSYMS_ALL=y
# Embedded .config for CONFIG_HZ detection by ktstr monitor.
# IKCONFIG_PROC exposes /proc/config.gz for runtime inspection.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# IKHEADERS exposes /sys/kernel/kheaders.tar.xz — the in-kernel copy
# of the headers that BPF tooling (bpftrace/BCC) falls back to when no
# kernel headers are installed. The ktstr guest is initramfs-only (no
# /lib/modules, no headers on disk), so without this a bpftrace binary
# shipped into shell mode via --include-files cannot compile programs
# that need kernel headers beyond what vmlinux BTF provides. Tristate;
# =y builds the archive into the image (the guest loads no modules, so
# a kheaders.ko would be unloadable anyway).
CONFIG_IKHEADERS=y

# -- Accounting --
# TASK_IO_ACCOUNTING: gates /proc/<tid>/io
# (rchar/wchar/syscr/syscw/read_bytes/write_bytes/cancelled_write_bytes,
# emitted by do_io_accounting() in fs/proc/base.c). The /proc/<tid>/io
# file itself is registered under #ifdef CONFIG_TASK_IO_ACCOUNTING.
# Depends on TASK_XACCT (which depends on TASKSTATS, declared above).
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
# PSI: standard pressure-stall infrastructure. Every major distro
# ships PSI=y. Per-CPU state machines with deferred averaging —
# minimal scheduling impact. Required for host-level and per-cgroup
# pressure capture. Active by default when compiled in
# (PSI_DEFAULT_DISABLED defaults to n); registers
# /proc/pressure/{io,memory,cpu,irq} via psi_proc_init() and
# exposes per-cgroup *.pressure files.
CONFIG_PSI=y

# IRQ_TIME_ACCOUNTING: fine-grained IRQ time accounting. The kernel
# timestamps each hardirq/softirq transition (irqtime_account_irq,
# kernel/sched/cputime.c:57) and accounts that time separately instead of
# charging it to the interrupted task; update_rq_clock_task subtracts the
# resulting irq_delta (kernel/sched/core.c:817) so rq->clock_task EXCLUDES
# IRQ time, and update_irq_load_avg feeds rq->avg_irq (core.c:840) — IRQ
# time becomes a signal distinct from task runtime. Deps (init/Kconfig:614):
# HAVE_IRQ_TIME_ACCOUNTING — selected by arch/x86/Kconfig:252 and
# arch/arm64/Kconfig:212 — and !VIRT_CPU_ACCOUNTING_NATIVE, which can never
# be set on x86_64/arm64 (its prereq HAVE_VIRT_CPU_ACCOUNTING is selected
# only by s390/powerpc). x86_64_defconfig lacks the symbol so this enables
# it there; arm64 defconfig already sets it, so on arm64 this is a
# defense-in-depth pin. =y survives make defconfig + merge + olddefconfig.
CONFIG_IRQ_TIME_ACCOUNTING=y

# -- Disabled (would alter scheduler behavior) --
# LOCKDEP: 10-100x lock overhead. Non-representative timing.
# Use for catching locking bugs, not for scheduler testing.
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_LOCKDEP is not set
# DEBUG_INFO_REDUCED: breaks BTF generation.
# CONFIG_DEBUG_INFO_SPLIT is not set

# -- Opt-in: changes scheduler behavior intentionally --
# Uncomment to enable broader test coverage at the cost of
# different scheduling characteristics.
#
# Full preemption (kernel preemptible at most points):
# CONFIG_PREEMPT=y
# CONFIG_PREEMPT_DYNAMIC=y
#
# Core scheduling (co-schedule trusted tasks on SMT siblings):
# CONFIG_SCHED_CORE=y

# -- Disable unnecessary subsystems (faster build) --
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WIRELESS is not set
# CONFIG_BLUETOOTH is not set
# CONFIG_INPUT is not set
# CONFIG_FB is not set
# CONFIG_VGA_CONSOLE is not set

# strip: SHT_NOBITS for code sections (8826d5d)
